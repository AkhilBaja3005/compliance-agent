# Aegis AI Safety & Regulatory Compliance Auditor Environment Configuration

# --- BYOM LLM Configuration (OpenAI-compatible client / Ollama / vLLM / Databricks) ---
BYOM_BASE_URL=http://localhost:11434/v1
BYOM_MODEL_NAME=llama3.1:8b
BYOM_API_KEY=ollama

# --- Databricks Mosaic AI Model Serving & Unity Catalog ---
USE_DATABRICKS=false
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi_sample_token
DATABRICKS_SERVING_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
DATABRICKS_CATALOG=compliance_catalog
DATABRICKS_SCHEMA=audit_prod
DATABRICKS_UNITY_CATALOG_TABLE=compliance_catalog.audit_prod.triaged_audit_reports
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_NAME=/Shared/aegis_ai_compliance_audit

# --- Linkup Deep Regulatory & Licensing Search ---
LINKUP_API_KEY=lk_sample_api_key

# --- MongoDB Atlas (Vector Search & LangGraph Checkpointer) ---
MONGODB_URI=mongodb+srv://user:pass@cluster0.sample.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=aegis_compliance
MONGODB_CHECKPOINT_COLLECTION=langgraph_checkpoints
MONGODB_RULES_COLLECTION=regulatory_rules
MONGODB_AUDIT_HISTORY_COLLECTION=audit_history

# --- Enterprise Connectors (GitHub & Confluence) ---
GITHUB_TOKEN=ghp_sample_personal_access_token
GITHUB_ORG=northwind-labs
CONFLUENCE_URL=https://northwindlabs.atlassian.net/wiki
CONFLUENCE_USERNAME=audit-service-account@northwindlabs.com
CONFLUENCE_API_TOKEN=sample_confluence_api_token
CONFLUENCE_SPACE_KEY=AIGOV

# --- Auditor Execution Settings ---
AUDIT_TARGET_DIR=./sample_connectors
AUDIT_OUTPUT_PDF=aegis_compliance_report.pdf

# --- Live dashboard (schedules start disabled; no audit runs on startup) ---
# Local paths default to the ignored .aegis directory; containers use /var/lib/aegis.
GRAPHITE_DASHBOARD_DB=./.aegis/dashboard.sqlite3
GRAPHITE_HISTORY_FILE=./.aegis/finding-history.json
# Compose defaults to offline auditing. Set false to enable configured model serving.
BYOM_OFFLINE=true
AUTO_SYNC=false
GRAPHITE_BIND_ADDRESS=127.0.0.1
GRAPHITE_PORT=8000

# --- Git server (enable the git profile in the project-wide Compose stack) ---
GRAPHITE_GIT_BIND_ADDRESS=127.0.0.1
GRAPHITE_GIT_PORT=2222
# Default: ./.aegis/authorized_keys, relative to the project root.
# Supply public SSH keys only; a dedicated copy supports SELinux relabeling.
# GRAPHITE_AUTHORIZED_KEYS=/absolute/path/to/public-authorized-keys

# --- API hardening (src/security.py). The API refuses all requests until keys are set. ---
# GRAPHITE_API_KEYS="key:tenants:role,..."  tenants = * or a|b ; role = admin | auditor | viewer. Generate keys with: python -c "import secrets;print(secrets.token_urlsafe(32))"
GRAPHITE_API_KEYS=
GRAPHITE_AUTH_DISABLED=false
GRAPHITE_RATE_LIMIT_PER_MIN=120
GRAPHITE_RATE_LIMIT_HEAVY_PER_MIN=10
GRAPHITE_MAX_BODY_BYTES=1048576
GRAPHITE_CORS_ORIGINS=
GRAPHITE_ALLOWED_GIT_HOSTS=github.com
GRAPHITE_PDF_ROOT=./regulatory_pdfs
GRAPHITE_DATA_DIR=./data
GRAPHITE_WORKERS=2
GRAPHITE_JOB_TIMEOUT_S=900
GRAPHITE_LOG_LEVEL=INFO

# --- Scope and rule library ---
# Comma list of EU_AI_ACT, EU_GDPR or ALL. Default: EU_AI_ACT,EU_GDPR
GRAPHITE_FRAMEWORKS=EU_AI_ACT,EU_GDPR
# Stage fetched rule changes for admin approval instead of applying them (GET /laws/pending)
GRAPHITE_RULE_REVIEW_REQUIRED=false

# --- Optional remote document sources (set GRAPHITE_REMOTE_DOC_SOURCES=true) ---
GRAPHITE_REMOTE_DOC_SOURCES=false
NOTION_TOKEN=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
SLACK_BOT_TOKEN=
SLACK_CHANNELS=
GOOGLE_ACCESS_TOKEN=
MS_GRAPH_TOKEN=
SHAREPOINT_DRIVE_ID=
GITHUB_ISSUES_REPO=
