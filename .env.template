# Environment template for the shared compose.yaml stack.
# Copy with: cp .env.template .env
# Local startup: GRAPHITE_AUTH_DISABLED=true podman compose up --build -d
# Optional integrations stay disconnected until their credentials are supplied.

# Dashboard host binding
GRAPHITE_BIND_ADDRESS=127.0.0.1
GRAPHITE_PORT=8000

# Authentication: key:tenants:role entries, separated by commas.
# Entry format: <generated-key>:*:admin
# With authentication enabled, protected routes require configured API keys.
GRAPHITE_AUTH_DISABLED=false
GRAPHITE_API_KEYS=

# Offline auditing with bundled companies; no automatic regulatory sync.
# COMPANIES_DIR is a container path; mount custom fixtures before changing it.
BYOM_OFFLINE=true
AUTO_SYNC=false
COMPANIES_DIR=/app/tests/fixtures/companies

# OpenAI-compatible model serving (set BYOM_OFFLINE=false to enable).
# Replace this URL with one reachable from the container for live models.
# 127.0.0.1 refers to the container itself, not the Podman host.
BYOM_BASE_URL=http://127.0.0.1:11434/v1
BYOM_MODEL_NAME=llama3.1:8b
BYOM_API_KEY=

# MongoDB Atlas (blank URI keeps the default SQLite backend).
MONGODB_URI=
MONGODB_DATABASE=graphite_compliance
MONGODB_TIMEOUT_MS=5000

# Databricks model serving, Unity Catalog and MLflow (optional).
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_SERVING_ENDPOINT=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=compliance_catalog
DATABRICKS_SCHEMA=audit_prod
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=

# Regulatory/license search and enterprise connectors (optional).
LINKUP_API_KEY=
GITHUB_TOKEN=
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=

# SSH Git server (enable with podman compose --profile git up --build -d).
GRAPHITE_GIT_BIND_ADDRESS=127.0.0.1
GRAPHITE_GIT_PORT=2222
# Public authorized-keys file, relative to the project root or an absolute path.
# Create this file before enabling the git profile; see README.md.
GRAPHITE_AUTHORIZED_KEYS=./.graphite/authorized_keys
