                  "snippet": {
                    "text": "prompt = f\"Analyze credit limit for customer: {request.applicant_name}, ID: {request.id}...\"\nreturn {\"decision\": \"AUTOMATED_LIMIT_REDUCTION\", \"appeal_route_available\": False}"
